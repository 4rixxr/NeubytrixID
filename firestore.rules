rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.uid == uid;
      match /documents/{documentId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.rawText is string
          && request.resource.data.rawText.size() <= 100000;
      }
      match /chat_sessions/{sessionId} { allow read, write: if owner(uid); }
    }
  }
}
