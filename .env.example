# Copy to .env.local. Never put service secrets in a VITE_* variable.
# Basic sample lessons, quizzes and flashcards work without an AI key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=3000
# Only set if deployed behind a known reverse proxy; do not use true blindly.
TRUST_PROXY_HOPS=0

# Optional Google login and document sync. Use your own Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=(default)

# Optional standalone Supabase adapter. Not required by the learning workspace.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
